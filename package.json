{
  "name": "i-persons",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter @ipersons/web build && pnpm db:migrate && pnpm --filter @ipersons/server seed:local && pnpm --filter @ipersons/server start",
    "dev:server": "pnpm --filter @ipersons/server dev",
    "dev:web": "pnpm --filter @ipersons/web dev",
    "chat": "pnpm --filter @ipersons/server chat",
    "db:generate": "pnpm --filter @ipersons/server db:generate",
    "db:migrate": "pnpm --filter @ipersons/server db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  }
}
