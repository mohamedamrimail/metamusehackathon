# i-persons configuration. Copy to .env:  cp .env.example .env
#
# Only META_API_KEY is REQUIRED. Everything else is OPTIONAL: leave it empty and the feature shows
# "not configured" (or falls back as described). With docker compose, DATABASE_URL, REDIS_URL, HOST, PORT,
# APP_URL, PUBLIC_URL and UPLOAD_DIR are set by docker-compose.yml, and JWT_SECRET / APP_ENCRYPTION_KEY are
# generated on first start.

# --- Meta Model API (all AI model calls go to Meta models) ---------------------------------------------
# REQUIRED. Your Meta Model API key. Without it (or if it's rejected) the app runs in demo mode with a
# warning banner: a simple rule-based stand-in answers instead of Muse Spark.
META_API_KEY=
# OPTIONAL. Meta's OpenAI-compatible endpoint (the `openai` npm package is only the client library).
META_BASE_URL=https://api.meta.ai/v1
# OPTIONAL. Muse Spark: the agent, rules checks, visitor/partner twins, email extraction, web search.
META_LLM_MODEL=muse-spark-1.3
# OPTIONAL. Muse Spark reasoning effort: minimal | low | medium | high | xhigh | max. "low" keeps voice turns fast.
META_REASONING_EFFORT=low
# OPTIONAL. Muse Voice Transcribe: realtime speech-to-text (WebSocket) and voice notes (HTTP).
META_STT_WS=wss://api.meta.ai/v1/asr/realtime
META_STT_HTTP=https://api.meta.ai/v1/asr/transcribe
# OPTIONAL. Muse Image: avatars from selfies, poses, styles, scenes.
META_IMAGE_MODEL=muse-image-1.0
# OPTIONAL. SAM 3.1: avatar cut-out, face, eyes and mouth.
META_SAM_MODEL=sam-3.1
# OPTIONAL. Timeout for one Muse Spark call, in ms.
LLM_TIMEOUT_MS=30000

# --- Server --------------------------------------------------------------------------------------------
# OPTIONAL. development (default) | production | test. Production requires JWT_SECRET and secure cookies (HTTPS).
NODE_ENV=development
# OPTIONAL. API port and listen address (docker compose sets HOST=0.0.0.0).
PORT=3000
HOST=127.0.0.1
# OPTIONAL. Port on your machine for docker compose (http://localhost:APP_PORT).
APP_PORT=3000
# OPTIONAL. Where the web app is opened; used in links. Default http://localhost:5173 (vite dev server).
APP_URL=
# OPTIONAL. Public base URL, for OAuth redirect URIs, emails and the glasses. Glasses need a public HTTPS URL.
PUBLIC_URL=
# OPTIONAL. Postgres. Without docker: a local database, e.g. postgres://ip:ip@localhost:5432/ipersons
DATABASE_URL=
# OPTIONAL. A separate *_test database for `pnpm test` (its tables are truncated).
TEST_DATABASE_URL=
# OPTIONAL. Redis for background jobs (opportunity scans, mailbox sync, nightly matching). Empty = jobs off.
REDIS_URL=
# OPTIONAL. Folder for uploaded and generated images. Default apps/server/uploads.
UPLOAD_DIR=
# OPTIONAL (REQUIRED when NODE_ENV=production). Session signing secret: openssl rand -hex 32
JWT_SECRET=
# OPTIONAL. Encrypts stored tokens (mailbox, MCP): openssl rand -base64 32. Needed to connect a mailbox or MCP server.
APP_ENCRYPTION_KEY=
# OPTIONAL. Key for hashing verified emails/phones (contact matching). Default: derived from APP_ENCRYPTION_KEY.
IDENTIFIER_HMAC_KEY=
# OPTIONAL. Per-IP / per-user rate limits: on | off.
RATE_LIMITS=on

# --- Demo user (created on first start by seed:local) ----------------------------------------------------
# OPTIONAL. Login of the local demo user. Defaults: demo@i-persons.test / ipersons-demo
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Access gates ----------------------------------------------------------------------------------------
# OPTIONAL. Country allowlist for new sign-ups: true | false (default false = every country). Always off when
# NODE_ENV=development.
ALLOWLIST_ENABLED=false
# OPTIONAL. Countries allowed when the allowlist is on (ISO codes); Admin → Countries overrides it.
ALLOWED_COUNTRIES=DE,TN,DK,US
# OPTIONAL. MaxMind GeoLite2 account for IP → country (only used when the allowlist is on). Without it: DB-IP Lite.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# OPTIONAL. Beta: new accounts wait for an admin's approval: on | off (default off).
BETA_APPROVAL=off
# OPTIONAL. Where approval requests are emailed (needs SMTP_URL).
APPROVAL_EMAIL=contact@i-persons.com
# OPTIONAL. Comma-separated emails with access to /admin. Add your own to see the admin panel.
ADMIN_EMAILS=

# --- WhatsApp Cloud API (Meta) ---------------------------------------------------------------------------
# OPTIONAL. All of these together turn WhatsApp on (verification, chat, voice notes, approval buttons).
# Without them WhatsApp shows "not configured" and setup lets you skip the WhatsApp step.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# The business number users message, e.g. +15551234567 (shown on the verification screen).
WA_PHONE_NUMBER=
# WhatsApp Business Account id (templates, webhook subscription).
WA_WABA_ID=
# Webhook verify token and app secret (signature check) for /api/whatsapp/webhook.
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
# Approved template for messages outside the 24 h window (one {{1}} body parameter), and its language.
WA_UPDATE_TEMPLATE=iperson_update
WA_TEMPLATE_LANG=en

# --- Sign-in and mailbox (OAuth) -------------------------------------------------------------------------
# OPTIONAL. "Continue with Google" and the read-only Gmail / contacts / calendar connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OPTIONAL. "Continue with Microsoft" and the read-only Outlook / contacts / calendar connection.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# OPTIONAL. "Continue with Facebook" (Facebook Login); the button is hidden without them.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# OPTIONAL. Facebook Login for Business configuration id (used instead of scopes).
FACEBOOK_LOGIN_CONFIG_ID=
# OPTIONAL. Mailbox demo limit: when MAIL_DEMO_MAILBOXES is set, only MAIL_DEMO_USERS may connect, only these mailboxes.
MAIL_DEMO_USERS=
MAIL_DEMO_MAILBOXES=
# OPTIONAL. Minutes between incremental mailbox syncs (needs REDIS_URL).
MAIL_SYNC_POLL_MINUTES=60

# --- Email -----------------------------------------------------------------------------------------------
# OPTIONAL. smtp://user:pass@host:587 for the emails a user approves. Without it they land in the Activity outbox.
SMTP_URL=
SMTP_FROM=i-persons <noreply@i-persons.com>
# OPTIONAL. Sender name shown on contact invites.
INVITE_FROM=contact@i-persons.com

# --- Other optional services (none of them AI) -----------------------------------------------------------
# OPTIONAL. Pexels stock photos for preset avatar scenes. Without it only custom scenes (Muse Image) are offered.
PEXELS_API_KEY=
# OPTIONAL. Payment provider for gifts and plans. None is integrated: requests wait as pending_payment.
PAYMENT_PROVIDER=
# OPTIONAL. Credentials of the Yousoft-IT recruiter portal (written by seed:yousoft).
YOUSOFT_CLIENT_ID=
YOUSOFT_CLIENT_SECRET=

# --- Background jobs ---------------------------------------------------------------------------------------
# OPTIONAL. Hours between background opportunity scans; 0 disables them (needs REDIS_URL).
SCAN_EVERY_HOURS=1
# OPTIONAL. Mock wallet, orders and paper trading: on | off. Unset = off in production, on elsewhere.
SHOW_SIMULATIONS=off

# --- AI credit (each Meta call is charged to the user's credit) -------------------------------------------
# OPTIONAL. Free credit for every new user, and the platform fee as a share of Meta's cost.
AI_FREE_CREDIT_USD=5
AI_PLATFORM_FEE_RATIO=1
# OPTIONAL. Meta list prices in USD (dev.meta.ai/docs/pricing-rate-limits). Reasoning tokens bill as output.
PRICE_LLM_INPUT_PER_M=1.25
PRICE_LLM_CACHED_INPUT_PER_M=0.15
PRICE_LLM_OUTPUT_PER_M=4.25
PRICE_IMAGE=0.01
PRICE_SAM_IMAGE=0.0025
PRICE_STT_PER_HOUR=0.18
